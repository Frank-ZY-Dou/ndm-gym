      "mug": "--st_fail_w 5 --reward_std_scale 3 --target_rate_w 4 --st_cost_mean",
      "tea": "--st_fail_w 5 --iterations 12000 --target_rate_w 4 --st_cost_mean"
    },
    "inspire": {
      "mustard_bottle": "--st_imag_noise 0.1 --reward_std_scale 3 --target_rate_w 4 --st_cost_mean",
